# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# 루트에 임시로 놓인 원본 이미지(R2에 업로드 후 로컬 원본은 버전관리 불필요)
/*.jpg
/*.jpeg
/*.png
/*.PNG
/*.JPG
/*.JPEG

# typescript
*.tsbuildinfo
next-env.d.ts
